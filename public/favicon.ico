<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" role="img" aria-labelledby="faviconTitle faviconDesc">
  <title id="faviconTitle">Bekzat Portfolio Favicon</title>
  <desc id="faviconDesc">Dark premium monogram icon with a bold B and red diagonal light beams.</desc>
  <defs>
    <linearGradient id="surface" x1="64" y1="36" x2="454" y2="476" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#16161c"/>
      <stop offset="0.55" stop-color="#09090b"/>
      <stop offset="1" stop-color="#020204"/>
    </linearGradient>
    <radialGradient id="vignette" cx="0" cy="0" r="1" gradientTransform="translate(100 84) rotate(40) scale(480 400)" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#ef4444" stop-opacity="0.26"/>
      <stop offset="0.34" stop-color="#dc2626" stop-opacity="0.14"/>
      <stop offset="1" stop-color="#000000" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="beamCore" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ff6b6b" stop-opacity="0.98"/>
      <stop offset="0.5" stop-color="#ef4444" stop-opacity="0.95"/>
      <stop offset="1" stop-color="#7f1d1d" stop-opacity="0.82"/>
    </linearGradient>
    <linearGradient id="beamGlow" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ef4444" stop-opacity="0.52"/>
      <stop offset="1" stop-color="#7f1d1d" stop-opacity="0"/>
    </linearGradient>
    <filter id="softGlow" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="14"/>
    </filter>
    <filter id="letterShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.38"/>
      <feDropShadow dx="0" dy="0" stdDeviation="8" flood-color="#ef4444" flood-opacity="0.16"/>
    </filter>
    <filter id="innerSoft" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="1.6"/>
    </filter>
  </defs>

  <rect width="512" height="512" rx="132" fill="#030304"/>
  <rect x="6" y="6" width="500" height="500" rx="124" fill="url(#surface)"/>
  <rect x="6" y="6" width="500" height="500" rx="124" fill="url(#vignette)"/>

  <g transform="translate(-22 8) rotate(34 110 120)">
    <rect x="84" y="-42" width="88" height="598" rx="44" fill="url(#beamGlow)" filter="url(#softGlow)"/>
    <rect x="106" y="-42" width="22" height="598" rx="11" fill="url(#beamCore)"/>
    <rect x="196" y="-42" width="66" height="598" rx="33" fill="url(#beamGlow)" filter="url(#softGlow)"/>
    <rect x="214" y="-42" width="16" height="598" rx="8" fill="url(#beamCore)"/>
  </g>

  <path d="M431 76c-22 16-46 41-63 63" fill="none" stroke="#ef4444" stroke-opacity="0.42" stroke-width="12" stroke-linecap="round"/>
  <path d="M83 426c64-4 113 9 155 28" fill="none" stroke="#ef4444" stroke-opacity="0.18" stroke-width="10" stroke-linecap="round"/>

  <circle cx="398" cy="128" r="44" fill="#ef4444" opacity="0.12" filter="url(#softGlow)"/>

  <g filter="url(#letterShadow)">
    <text
      x="290"
      y="348"
      text-anchor="middle"
      font-size="252"
      font-weight="700"
      font-family="Verdana, Arial, sans-serif"
      fill="#fafafa"
      letter-spacing="-12"
    >B</text>
  </g>

  <text
    x="290"
    y="348"
    text-anchor="middle"
    font-size="252"
    font-weight="700"
    font-family="Verdana, Arial, sans-serif"
    fill="none"
    stroke="#ef4444"
    stroke-opacity="0.18"
    stroke-width="7"
    letter-spacing="-12"
    filter="url(#innerSoft)"
  >B</text>
</svg>
